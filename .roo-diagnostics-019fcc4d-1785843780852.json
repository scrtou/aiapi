.h/cpp    # 账号 CRUD + Token 刷新 + 自动注册\n248 |     │\n249 |     ├── managedAccount/            # 更高层账号/工作区抽象\n250 |     │   ├── contracts/\n251 |     │   │   └── ManagedAccount.h    # 统一资产记录 / 执行上下文\n252 |     │   ├── backends/\n253 |     │   │   ├── IManagedAccountBackend.h\n254 |     │   │   ├── ClassicProviderAccountBackend.h/cpp\n255 |     │   │   └── RetoolWorkspaceBackend.h/cpp\n256 |     │   └── service/\n257 |     │       └── ManagedAccountService.h/cpp\n258 |     │\n259 |     ├── retoolWorkspace/           # Retool Workspace 子系统\n260 |     │   ├── RetoolWorkspaceInfo.h\n261 |     │   ├── RetoolWorkspaceManager.h/cpp\n262 |     │   └── RetoolWorkspaceService.h/cpp\n263 |     │\n264 |     ├── channelManager/             # 渠道管理\n265 |     │   └── channelManager.h/cpp    # 渠道 CRUD + 状态控制\n266 |     │\n267 |     ├── dbManager/                  # 数据库管理\n268 |     │   ├── DbType.h                # 数据库类型枚举（PostgreSQL/MySQL/SQLite3）\n269 |     │   ├── account/\n270 |     │   │   ├── accountDbManager.h/cpp       # 账号持久化\n271 |     │   │   └── accountBackupDbManager.h/cpp # 账号备份持久化\n272 |     │   ├── channel/\n273 |     │   │   └── channelDbManager.h/cpp       # 渠道持久化\n274 |     │   ├── config/\n275 |     │   │   └── ConfigDbManager.h/cpp        # 配置持久化（app_config 表）\n276 |     │   ├── retoolWorkspace/\n277 |     │   │   └── RetoolWorkspaceDbManager.h/cpp # Retool Workspace 持久化\n278 |     │   └── metrics/\n279 |     │       ├── ErrorStatsDbManager.h/cpp    # 错误统计持久化\n280 |     │       └── StatusDbManager.h/cpp        # 服务状态持久化\n281 |     │\n282 |     ├── metrics/                    # 错误统计服务\n283 |     │   ├── ErrorEvent.h            # 错误事件定义\n284 |     │   ├── ErrorStatsConfig.h/cpp  # 错误统计配置\n285 |     │   └── ErrorStatsService.h/cpp # 错误记录服务\n286 |     │\n287 |     ├── models/                     # 数据模型\n288 |     │   └── model.json              # 模型定义文件\n289 |     │\n290 |     ├── tools/                      # 工具类\n291 |     │   ├── ZeroWidthEncoder.h/cpp  # 零宽字符编码/解