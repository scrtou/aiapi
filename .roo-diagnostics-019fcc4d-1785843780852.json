ver + TextExtractor）\n 49 | - ✅ 响应索引（ResponseIndex）— Responses API GET/DELETE 支持\n 50 | - ✅ 并发门控（SessionExecutionGate + CancellationToken + RAII Guard）\n 51 | - ✅ 输出清洗（ClientOutputSanitizer）\n 52 | - ✅ 统一错误模型（Errors）+ 错误统计（ErrorStatsService + ErrorStatsConfig）\n 53 | - ✅ 账号池管理（自动注册、Token 刷新、类型检测、轮转、备份）\n 54 | - ✅ ManagedAccount 抽象层（传统账号 + Retool Workspace 统一管理入口）\n 55 | - ✅ Retool Workspace 资产管理（workspace/session/workflow/agent 元数据持久化）\n 56 | - ✅ Retool Workspace 创建入口（通过 aiapi_tool 内部编排执行）\n 57 | - ✅ 渠道管理（多渠道、状态控制、并发限制）\n 58 | - ✅ 服务状态监控 + Prometheus 指标导出\n 59 | - ✅ 内置日志查看 API（文件列表、尾部读取、过滤）\n 60 | - ✅ 管理接口认证（AdminAuthFilter）\n 61 | - ✅ 请求限流（RateLimitFilter）\n 62 | - ✅ 配置校验（ConfigValidator）\n 63 | - ✅ 后台任务队列（BackgroundTaskQueue）\n 64 | - ✅ 健康检查端点（/health + /ready）\n 65 | - ✅ 完善的单元测试（12 个功能测试 + `test_main.cc` 测试入口）\n 66 | \n 67 | ## 架构概览\n 68 | \n 69 | ```\n 70 | ┌─────────────────────────────────────────────────────────────────┐\n 71 | │                         HTTP 层                                  │\n 72 | │  ┌─────────────────────────────────────────────────────────┐    │\n 73 | │  │              Controllers + Filters                      │    │\n 74 | │  │  AiApiController     — AI 核心 API 路由                 │    │\n 75 | │  │  AccountController   — 账号管理 API                     │    │\n 76 | │  │  RetoolWorkspaceController — Retool Workspace API       │    │\n 77 | │  │  ChannelController   — 渠道管理 API                     │    │\n 78 | │  │  MetricsController   — 监控指标 API                     │    │\n 79 | │  │  LogController       — 日志查看 API                     │    │\n 80 | │  │  HealthController    — 健康检查 API                     │    │\n 81 | │  │  AdminAuthFilter     — 管理接口认证                     │    │\n 82 | │  │  RateLimitFilter     — 请求限流                         │    │\n 83 | │  └─────────────────────────────────────────────────────────┘    │\n 84 | └─────────────────────────────────────────────────────────────────┘\n 85 |                               │\n 86 |                               ▼\n 87 | ┌─────────────────────────────────────────────────────────────────┐\n 88 | │                        适配层                                    │\n 89 | │  ┌─────────────────┐     ┌──────────────────────────────────┐  │\n 90 | │  │ RequestAdapters │ ──▶ │      GenerationRequest           │  │\n 91 | │  │ (Chat/Responses)│     │ (统一请求结构)                    │  │\n 92 | │  └─────────────────┘     └──────────────────────────────────┘  │\n 93 | └─────────────────────────────────────────────────────────────────┘\n 94 |                               │\n 95 |                               ▼\n 96 | ┌─────────────────────────────────────────────────────────────────┐\n 97 | │                      生成编排层                                  │\n 98 | │  ┌─────────────────────────────────────────────────────────┐    │\n 99 | │  │               GenerationService                          │    │\n100 | │  │  - runGuarded()          (主入口，含并发门控)             │    │\n101 | │  │  - materializeSession()  (请求 → 会话)                   │    │\n102 | │  │  - executeProvider()     (调用上游)                       │    │\n103 | │  │  - emitResultEvents()    (结果处理 + 事件发送)            │    │\n104 | │  └─────────────────────────────────────────────────────────┘    │\n105 | │     │           │              │              │              │   │\n106 | │     ▼           ▼              ▼              ▼              ▼   │\n107 | │  ┌────────┐ ┌────────┐ ┌──────────┐ ┌──────────┐ ┌──────────┐  │\n108 | │  │ToolCall│ │Session │ │ToolCall  │ │Output    │ │Continuity│  │\n109 | │  │Bridge  │ │Manager │ │Validator │ │Sanitizer │ │Resolver  │  │\n110 | │  └────────┘ └────────┘ └──────────┘ └──────────┘ └──────────┘  │\n111 | │     │                                                           │\n112 | │     ▼                                                           │\n113 | │  ┌──────────────────┐                                           │\n114 | │  │SessionExecution  │ (并发门控 + CancellationToken)            │\n115 | │  │Gate              │                                           │\n116 | │  └──────────────────┘                                           │\n117 | └─────────────────────────────────────────────────────────────────┘\n118 |                               │\n119 |                               ▼\n120 | ┌─────────────────────────────────────────────────────────────────┐\n121 | │                      Provider 层                                 │\n122 | │  ┌─────────────┐     ┌─────────────────────────────────────┐   │\n123 | │  │  ApiManager │ ──▶ │         APIinterface                │   │\n124 | │  │  (路由选择)  │     │  - generate()                       │   │\n125 | │  │  ApiFactory  │     │  - ProviderResult                   │   │\n126 | │  └─────────────┘     └─────────────────────────────────────┘   │\n127 | │        │                                                        │\n128 | │        ├── chaynsapi (Chayns AI Provider)                       │\n129 | │        ├── nexosapi  (Nexos Web Provider)                       │\n130 | │        └── openai    (OpenAI 兼容 Provider)                     │\n131 | └─────────────────────────────────────────────────────────────────┘\n132 |                               │\n133 |                               ▼\n134 | ┌─────────────────────────────────────────────────────────────────┐\n135 | │                       输出层                                     │\n136 | │  ┌───────────────┐  ┌───────────────┐  ┌───────────────────┐   │\n137 | │  │ IResponseSink │  │GenerationEvent│  │   HTTP Response   │   │\n138 | │  │  (接口)       │◀─│  (事件模型)    │──▶│  (JSON/SSE)       │   │\n139 | │  └───────────────┘  └───────────────┘  └───────────────────┘   │\n140 | │        │                                                         │\n141 | │        ├── ChatJsonSink      (Chat 非流式 JSON)                  │\n142 | │        ├── ChatSseSink       (Chat 流式 SSE)                     │\n143 | │        ├── ResponsesJsonSink (Responses 非流式 JSON)              │\n144 | │        ├── ResponsesSseSink  (Responses 流式 SSE)                │\n145 | │        ├── CollectorSink     (事件收集，内部用)                   │\n146 | │        └── NullSink          (丢弃输出，测试用)                   │\n147 | └─────────────────────────────────────────────────────────────────┘\n148 | ```\n149 | \n150 | ## 项目结构\n151 | \n152 | ```\n153 | aiapi/\n154 | ├── CMakeLists.txt                  # CMake 构建配置（根目录）\n155 | ├── Dockerfile                      # Docker 构建文件\n156 | ├── config.example.json             # 配置文件模板（JSON）\n157 | ├── config.sqlite.example.json      # SQLite 配置模板\n158 | ├── docker-compose.env.yml          # Docker Compose（环境变量方式）\n159 | ├── docker-compose.volume.yml       # Docker Compose（卷挂载方式）\n160 | ├── requirements.txt                # Python 依赖（登录/注册服务）\n161 | ├── doc/                            # 文档目录\n162 | │   ├── aiapi_callflow_and_api_examples.md  # 详细调用关系与接口样例\n163 | │   ├── development-plan.md                 # 开发计划\n164 | │   ├── optimization-report.md              # 优化报告\n165 | │   ├── error_stats_dev_plan.md             # 错误统计开发计划\n166 | │   ├── service_status_monitoring_design.md # 服务状态监控设计\n167 | │   ├── aiapi 错误统计与监控方案（设计文档）   # 错误统计与监控方案设计\n168 | │   └── session/                            # 会话连续性模块文档\n169 | │       ├── README.md                       #   会话模块索引\n170 | │       ├── session_continuity_refactor_design.md          # 重构设计\n171 | │       └── session_continuity_refactor_development_plan.md # 重构开发计划\n172 | │\n173 | └── src/\n174 |     ├── CMakeLists.txt              # CMake 构建配置（源码）\n175 |     ├── main.cc                     # 程序入口\n176 |     ├── config.yaml                 # Drogon YAML 运行配置\n177 |     │\n178 |     ├── controllers/                # HTTP 控制器 + 过滤器\n179 |     │   ├── AiApiController.h/cc    # AI 核心 API 路由控制器\n180 |     │   ├── AccountController.h/cc  # 账号管理 API 控制器\n181 |     │   ├── RetoolWorkspaceController.h/cc # Retool Workspace API 控制器\n182 |     │   ├── ChannelContr