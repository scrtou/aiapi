lationToken)            │\n115 | │  │Gate              │                                           │\n116 | │  └──────────────────┘                                           │\n117 | └─────────────────────────────────────────────────────────────────┘\n118 |                               │\n119 |                               ▼\n120 | ┌─────────────────────────────────────────────────────────────────┐\n121 | │                      Provider 层                                 │\n122 | │  ┌─────────────┐     ┌─────────────────────────────────────┐   │\n123 | │  │  ApiManager │ ──▶ │         APIinterface                │   │\n124 | │  │  (路由选择)  │     │  - generate()                       │   │\n125 | │  │  ApiFactory  │     │  - ProviderResult                   │   │\n126 | │  └─────────────┘     └─────────────────────────────────────┘   │\n127 | │        │                                                        │\n128 | │        ├── chaynsapi (Chayns AI Provider)                       │\n129 | │        ├── nexosapi  (Nexos Web Provider)                       │\n130 | │        └── openai    (OpenAI 兼容 Provider)                     │\n131 | └─────────────────────────────────────────────────────────────────┘\n132 |                               │\n133 |                               ▼\n134 | ┌─────────────────────────────────────────────────────────────────┐\n135 | │                       输出层                                     │\n136 | │  ┌───────────────┐  ┌───────────────┐  ┌───────────────────┐   │\n137 | │  │ IResponseSink │  │GenerationEvent│  │   HTTP Response   │   │\n138 | │  │  (接口)       │◀─│  (事件模型)    │──▶│  (JSON/SSE)       │   │\n139 | │  └───────────────┘  └───────────────┘  └───────────────────┘   │\n140 | │        │                                                         │\n141 | │        ├── ChatJsonSink      (Chat 非流式 JSON)                  │\n142 | │        ├── ChatSseSink       (Chat 流式 SSE)                     │\n143 | │        ├── ResponsesJsonSink (Responses 非流式 JSON)              │\n144 | │        ├── ResponsesSseSink  (Responses 流式 SSE)                │\n145 | │        ├── CollectorSink     (事件收集，内部用)                   │\n146 | │        └── NullSink          (丢弃输出，测试用)                   │\n147 | └─────────────────────────────────────────────────────────────────┘\n148 | ```\n149 | \n150 | ## 项目结构\n151 | \n152 | ```\n153 | aiapi/\n154 | ├── CMakeLists.txt                  # CMake 构建配置（根目录）\n155 | ├── Dockerfile                      # Docker 构建文件\n156 | ├── config.example.json             # 配置文件模板（JSON）\n157 | ├── config.sqlite.example.json      # SQLite 配置模板\n158 | ├── docker-compose.env.yml          # Docker Compose（环境变量方式）\n159 | ├── docker-compose.volume.yml       # Docker Compose（卷挂载方式）\n160 | ├── requirements.txt                # Python 依赖（登录/注册服务）\n161 | ├── doc/                            # 文档目录\n162 | │   ├── aiapi_callflow_and_api_examples.md  # 详细调用关系与接口样例\n163 | │   ├── development-plan.md                 # 开发计划\n164 | │   ├── optimization-report.md              # 优化报告\n165 | │   ├── error_stats_dev_plan.md             # 错误统计开发计划\n166 | │   ├── service_status_monitoring_design.md # 服务状态监控设计\n167 | │   ├── aiapi 错误统计与监控方案（设计文档）   # 错误统计与监控方案设计\n168 | │   └── session/                            # 会话连续性模块文档\n169 | │       ├── README.md                       #   会话模块索引\n170 | │       ├── session_continuity_refactor_design.md          # 重构设计\n171 | │       └── session_continuity_refactor_development_plan.md # 重构开发计划\n172 | │\n173 | └── src/\n174 |     ├── CMakeLists.txt              # CMake 构建配置（源码）\n175 |     ├── main.cc                     # 程序入口\n176 |     ├── config.yaml                 # Drogon YAML 运行配置\n177 |     │\n178 |     ├── controllers/                # HTTP 控制器 + 过滤器\n179 |     │   ├── AiApiController.h/cc    # AI 核心 API 路由控制器\n180 |     │   ├── AccountController.h/cc  # 账号管理 API 控制器\n181 |     │   ├── RetoolWorkspaceController.h/cc # Retool Workspace API 控制器\n182 |     │   ├── ChannelContr